# App settings
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Backend
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are optional. Use them only when JWT_ALGORITHM is RS256, ES256, PS256, etc.
# Example:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DATABASE_URL=postgresql+psycopg://mbaara:mbaara@127.0.0.1:5432/mbaara_dev
REDIS_URL=redis://127.0.0.1:6379/0
VITE_API_BASE_URL=http://127.0.0.1:8000

# API URL for frontend development.
# If using a tunnel, replace this with the tunnel URL returned by `npm run dev:tunnel`.
# Example: VITE_API_BASE_URL=https://your-tunnel-url.loca.lt

# Supabase auth config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Audio / AI
WHISPER_MODEL=small
TTS_PROVIDER=gt

# Storage
UPLOAD_DIR=./uploads
