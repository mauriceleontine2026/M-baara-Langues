  "grammar_points": [
    {
      "concept": "L'accord de genre pour le remerciement",
      "explanation": "En portugais, le mot pour dire 'merci' s'accorde avec le genre de la personne qui parle, et non avec la personne à qui l'on s'adresse.",
      "rules": [
        "Un homme doit toujours dire 'Obrigado'.",
        "Une femme doit toujours dire 'Obrigada'."
      ],
      "examples": [
        {
          "structure": "Homme parlant : Obrigado, senhor.",
          "phonetic_api": "/obɾiˈɡaðu sɨˈɲoɾ/",
          "meaning": "Merci, monsieur."
        },
        {
          "structure": "Femme parlant : Obrigada, senhora.",
          "phonetic_api": "/obɾiˈɡaðɐ sɨˈɲoɾɐ/",
          "meaning": "Merci, madame."
        }
      ]
    },
    {
      "concept": "Le tutoiement et le vouvoiement (Introduction)",
      "explanation": "La distinction entre le registre formel et informel se marque par la conjugaison du verbe à la 2ème personne (informel) ou à la 3ème personne (formel).",
      "rules": [
        "Tu es / Tu vas : utilisation de la terminaison en -s (ex: estás).",
        "Vous êtes / Vous allez : utilisation de la forme de 3ème personne sans pronom explicite ou avec le nom (ex: está)."
      ],
      "examples": [
        {
          "structure": "Informel : Como estás?",
          "phonetic_api": "/ˈkomu ɨʃˈtaʃ/",
          "meaning": "Comment vas-tu ?"
        },
        {
          "structure": "Formel : Como está?",
          "phonetic_api": "/ˈkomu ɨʃˈta/",
          "meaning": "Comment allez-vous ?"
        }
      ]
    }
  ],
