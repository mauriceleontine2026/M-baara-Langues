  "grammar_points": [
    {
      "concept": "Les digrammes spécifiques : LH, NH et CH",
      "explanation": "Le portugais utilise trois combinaisons de consonnes clés qui modifient profondément la prononciation par rapport au français.",
      "rules": [
        "'CH' se prononce comme le 'ch' français dans 'chemin' [ʃ].",
        "'LH' correspond au son palatal liquide [ʎ], similaire au groupe 'lli' dans 'allier'.",
        "'NH' correspond au son palatal nasal [ɲ], identique au 'gn' français dans 'gagner'."
      ],
      "examples": [
        {
          "structure": "Chá (Thé)",
          "phonetic_api": "/ʃa/",
          "meaning": "Thé"
        },
        {
          "structure": "Olho (Œil)",
          "phonetic_api": "/ˈoʎu/",
          "meaning": "Œil"
        },
        {
          "structure": "Vinho (Vin)",
          "phonetic_api": "/ˈviɲu/",
          "meaning": "Vin"
        }
      ]
    },
    {
      "concept": "Les accents graphiques et la nasalité",
      "explanation": "Les accents en portugais servent à indiquer la syllabe tonique (accentuée) et modifient parfois l'ouverture de la voyelle ou marquent la nasalisation.",
      "rules": [
        "L'accent aigu (´) indique une voyelle ouverte et tonique (ex: café, água).",
        "L'accent circonflexe (^) indique une voyelle fermée et tonique (ex: três, você).",
        "Le tilde (~) indique uniquement que la voyelle est nasale (ex: pão, mãe)."
      ],
      "examples": [
        {
          "structure": "Maçã",
          "phonetic_api": "/mɐˈsɐ̃/",
          "meaning": "Pomme"
        },
        {
          "structure": "Avó vs Avô",
          "phonetic_api": "/ɐˈvɔ/ vs /ɐˈvo/",
          "meaning": "Grand-mère (ouvert) vs Grand-père (fermé)"
        }
      ]
    }
  ],
