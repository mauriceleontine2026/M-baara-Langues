rules_version = '2';

// No client code currently uses Firebase Storage (audio/media are served
// from the FastAPI backend's own /static/audio path instead — see
// backend/app/routers/audio.py). Default-deny until a real use case with
// proper per-user scoping and validation is defined.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
